import logging
from aiogram import Bot, Dispatcher, executor, types
from aiogram.contrib.fsm_storage.memory import MemoryStorage
from aiogram.dispatcher import FSMContext
from aiogram.dispatcher.filters.state import State, StatesGroup
import sqlite3
import yt_dlp

# --- Sozlamalar ---
API_TOKEN = '8870187278:AAEEe_heDhMy9zzQXpg48xC-zzQjIe5YDbg'
CHANNEL_ID = '@insta_aqlli_bot' # Majburiy obuna kanali
bot = Bot(token=API_TOKEN)
storage = MemoryStorage()
dp = Dispatcher(bot, storage=storage)

# --- Baza va FSM ---
conn = sqlite3.connect('users.db')
cursor = conn.cursor()
cursor.execute('CREATE TABLE IF NOT EXISTS users (id INTEGER PRIMARY KEY, referrals INTEGER DEFAULT 0)')
conn.commit()

class FSM(StatesGroup):
    waiting_for_link = State()

# --- Tugmalar (Menu) ---
def get_main_menu():
    markup = types.ReplyKeyboardMarkup(resize_keyboard=True, row_width=1)
    markup.add("🎬 Video/Hashtag ajratish 🥶", "Tekin nakrutka 🎁", "Rek heshteg 📈", "Help")
    return markup

def get_rek_menu():
    markup = types.InlineKeyboardMarkup(row_width=2)
    markup.add(
        types.InlineKeyboardButton("🇯🇵 Yapon", callback_data="lang_yapon"),
        types.InlineKeyboardButton("🇦🇪 Mashina", callback_data="lang_mashina"),
        types.InlineKeyboardButton("🇬🇧 Humans", callback_data="lang_humans"),
        types.InlineKeyboardButton("🇫🇷 Sport", callback_data="lang_sport")
    )
    return markup

# --- Funksiyalar ---
def get_info(url):
    ydl_opts = {'format': 'best', 'outtmpl': 'video.mp4'}
    with yt_dlp.YoutubeDL(ydl_opts) as ydl:
        info = ydl.extract_info(url, download=True)
        return info.get('title'), info.get('description', ''), 'video.mp4'

# --- Handlers ---
@dp.message_handler(commands=['start'])
async def start(message: types.Message):
    # Majburiy obuna
    member = await bot.get_chat_member(CHANNEL_ID, message.from_user.id)
    if member.status == 'left':
        await message.answer(f"Botdan foydalanish uchun {CHANNEL_ID} kanaliga obuna bo'ling!")
        return

    # Referral qo'shish
    args = message.get_args()
    if args and args.isdigit():
        cursor.execute('UPDATE users SET referrals = referrals + 1 WHERE id = ?', (args,))
        conn.commit()
    
    cursor.execute('INSERT OR IGNORE INTO users (id) VALUES (?)', (message.from_user.id,))
    conn.commit()
    await message.answer("Xush kelibsiz! Kerakli bo'limni tanlang:", reply_markup=get_main_menu())

@dp.message_handler(text="Rek heshteg 📈")
async def rek_heshteg(message: types.Message):
    await message.answer("Yo'nalishni tanlang:", reply_markup=get_rek_menu())

@dp.callback_query_handler(lambda c: c.data.startswith('lang_'))
async def send_lang_content(call: types.CallbackQuery):
    lang = call.data.split("_")[1]
    data = {
        "yapon": "🇯🇵 日本の伝統と現代の美しさが融合する場所。旅行や文化体験に最適な国。\n#日本 #文化 #旅行 #観光 #伝統 #Tokyo #Japan",
        "mashina": "🇦🇪 السيارات الفاخرة تعبر عن القوة والأناقة. القيادة في دبي تجربة لا تنسى.\n#سيارات #دبي #فخامة #سرعة #DubaiCars #Luxury",
        "humans": "🇬🇧 Humans are the most complex beings. Every story has a unique meaning and deep perspective.\n#humanity #life #story #people #perspective #world",
        "sport": "🇫🇷 Le sport est une passion universelle qui unit les gens par-delà les frontières.\n#sport #france #passion #football #training #fitness #lifestyle"
    }
    await call.message.answer(data.get(lang))

@dp.message_handler(text="Tekin nakrutka 🎁")
async def nakrutka(message: types.Message):
    cursor.execute('SELECT referrals FROM users WHERE id = ?', (message.from_user.id,))
    res = cursor.fetchone()
    count = res[0] if res else 0
    if count >= 10:
        await message.answer("Tabriklaymiz! Mana sayt: [leofame.com]")
    else:
        await message.answer(f"Sizda {count}/10 do'st bor. Yana {10-count} ta do'st taklif qiling!")

@dp.message_handler(text="🎬 Video/Hashtag ajratish 🥶")
async def extract_start(message: types.Message):
    await message.answer("Instagram havolasini yuboring:")
    await FSM.waiting_for_link.set()

@dp.message_handler(state=FSM.waiting_for_link)
async def process_link(message: types.Message, state: FSMContext):
    try:
        title, caption, path = get_info(message.text)
        await message.answer_video(open(path, 'rb'), caption=f"Matn: {title}")
        hashtags = [w for w in caption.split() if w.startswith('#')]
        await message.answer(f"Hashtaglar: {' '.join(hashtags)}")
    except:
        await message.answer("Xatolik! Havola noto'g'ri.")
    await state.finish()

if __name__ == '__main__':
    executor.start_polling(dp, skip_updates=True)
